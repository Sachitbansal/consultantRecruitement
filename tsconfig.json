{
  "compilerOptions": {
    // ES2020 (not the create-next-app default of ES5) because the landing page
    // and contact endpoint use unicode-flag regexes, which need ES6+.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // The ported landing components import their logo as a static asset
      // (`@/public/gop-mark.png`). In the original GOP repo `@/` pointed at the
      // project root; here it points at src/, so public/ needs its own alias.
      "@/public/*": ["./public/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
