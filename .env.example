# ---------------------------------------------------------------------------
# GOP Consultant Recruitment Portal — environment variables
#
# Copy this file to `.env` in the same directory as docker-compose.yml on
# the server, then fill in real values. `.env` is gitignored and must NEVER
# be committed. Values marked "CHANGE BEFORE PRODUCTION" are placeholders —
# the app/db will run with them, but they are not safe for a live server.
# ---------------------------------------------------------------------------

# --- Postgres credentials, used by the `db` service ---
# CHANGE BEFORE PRODUCTION.
POSTGRES_USER=gop
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=gop

# --- Prisma connection string, used by the `app` service ---
# Host MUST be `db` (the Docker Compose service name), not `localhost` —
# the app container reaches Postgres over the internal Compose network.
# Keep the user/password/db name in sync with the three POSTGRES_* values
# above (this is not derived automatically by Compose).
# CHANGE BEFORE PRODUCTION (must match POSTGRES_PASSWORD above).
DATABASE_URL="postgresql://gop:change_me_to_a_long_random_password@db:5432/gop?schema=public"

# --- Admin session secret ---
# Used to sign/encrypt admin login sessions (wired up in a later step —
# reserved here so it's already available when that lands).
# Generate a real value with: openssl rand -base64 32
# CHANGE BEFORE PRODUCTION.
SESSION_SECRET=change_me_generate_with_openssl_rand_base64_32

# --- First admin user bootstrap ---
# Consumed by a seed/setup script (added in a later step) to create the
# first admin login. Change the password to something strong; the email
# should be a real address the client controls.
# CHANGE BEFORE PRODUCTION.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_to_a_strong_password

# --- Admin session cookie transport ---
# The admin login route sets `Secure` on the session cookie whenever
# NODE_ENV=production (which it is in docker-compose.yml). `Secure` cookies
# are silently dropped by browsers on plain HTTP origins. Until the nginx +
# TLS step lands (see docker-compose.yml comments), the app is served over
# plain HTTP on 127.0.0.1:3000, so a `Secure` cookie would make the admin
# login UNUSABLE. Set this to "true" ONLY for that interim plain-HTTP
# window; remove it (or set to "false") once TLS termination is in place —
# leaving it "true" in real production would allow the session cookie to be
# sent over an unencrypted connection.
# CHANGE BEFORE PRODUCTION (set to "false" once behind HTTPS).
FORCE_INSECURE_COOKIES=true

# --- CV upload storage root, used by the `app` service ---
# Must match the container-side mount point of the `cv_uploads` volume in
# docker-compose.yml (/app/uploads). Local `npm run dev` has no such path,
# so this is only required in the container; the API route falls back to a
# repo-local ./uploads directory when unset.
UPLOADS_DIR=/app/uploads

# --- Host port the app is published on (localhost only) ---
# nginx/reverse proxy fronts this and terminates TLS. Container always
# listens on 3000 internally; this only changes the host-side mapping.
APP_PORT=8001

# --- Contact form (landing page enquiries) ---
# SMTP mailbox that sends enquiry + acknowledgement mail. The mailbox already
# exists in cPanel (Email Accounts) for sbssdigital.com. From MUST stay on the
# authenticated domain or SPF/DKIM fails.
SMTP_HOST=mail.sbssdigital.com
SMTP_PORT=465                 # 465 = implicit TLS. Use 587 if 465 is blocked.
SMTP_USER=noreply@sbssdigital.com
SMTP_PASS=                    # mailbox password. REQUIRED — form 500s without it.
CONTACT_FROM_EMAIL=noreply@sbssdigital.com
CONTACT_FROM_NAME=Growth Operating Partners
# Where enquiries land.
CONTACT_TO_EMAIL=avneesh.bansal@sbssdigital.com
CONTACT_TO_NAME=Avneesh Bansal
# Browser origins allowed to POST. Scheme + host only, comma-separated.
CONTACT_ALLOWED_ORIGINS=https://gop.sbssdigital.com
CONTACT_SEND_ACK=true
CONTACT_VERIFY_EMAIL_DOMAIN=true
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SEC=900
